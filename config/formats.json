{
  "version": 2,
  "description": "Luật NỘI DUNG theo độ dài video (short | long). Không chứa kích thước hay cỡ chữ: phần bố cục nằm ở config/aspects.json, vì cùng một kịch bản có thể render ở nhiều khung hình.",
  "wordsPerSecond": 3.1,
  "formats": {
    "short": {
      "label": "Short",
      "defaultAspect": "vertical",
      "targetDurationSec": [20, 60],
      "sceneCount": [8, 25],
      "sceneDurationSec": [1.5, 5],
      "maxWordsPerScene": 14,
      "maxBullets": 3,
      "hookWindowSec": 1.5,
      "platforms": ["tiktok", "reels", "shorts"],
      "sceneTypes": [
        "hook", "stat", "punch", "list", "timeline", "compare",
        "captionStack", "title", "bullets", "quote", "imageFull",
        "chart", "outro"
      ],
      "firstSceneType": "hook",
      "requiredSceneTypes": ["hook", "outro"]
    },
    "long": {
      "label": "Long",
      "defaultAspect": "horizontal",
      "targetDurationSec": [300, 900],
      "sceneCount": [20, 90],
      "sceneDurationSec": [6, 25],
      "maxWordsPerScene": 55,
      "maxBullets": 4,
      "hookWindowSec": 15,
      "platforms": ["youtube"],
      "sceneTypes": [
        "title", "chapter", "bullets", "quote", "imageFull",
        "chart", "stat", "lowerThird", "recap", "outro"
      ],
      "firstSceneType": "title",
      "requiredSceneTypes": ["title", "outro"],
      "minChapterScenes": 2
    }
  }
}
